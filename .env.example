# Local development only. Copy values into your shell; never commit actual credentials.
VAULT_ENVIRONMENT=development
# Set a distinct random password before starting the optional database container.
VAULT_POSTGRES_PASSWORD=
VAULT_POSTGRES_PORT=5442
# The API guest learning slice also runs without a database. Account APIs are not enabled.
VAULT_DATABASE_URL=
VAULT_ALLOWED_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
# Optional routed learning assistant; disabled unless explicitly enabled with a server-side key.
VAULT_AGENT_ENABLED=false
VAULT_DEEPSEEK_API_KEY=
VAULT_DEEPSEEK_MODEL=deepseek-flash
VAULT_AGENT_TIMEOUT_SECONDS=30
VAULT_AGENT_MAX_INFLIGHT=8
