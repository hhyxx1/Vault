      "objective_codes": [
        "WORKSHOP-M01-O1"
      ],
      "kind": "code",
      "title": "把分段计费改写成读取输入的通用程序",
      "student_action": "先预测 30/60 端点输出，再把程序改为从标准输入读取分钟数；提交独立语义核验，用未公开的多组输入检验是否只是硬编码 30/60。",
      "theory": [
        "单个输入通过只说明该输入未暴露问题；端点及其两侧用于暴露区间缺口。",
        "把常量改为读取输入后，仍需在多组独立输入上验证分支条件是否包含端点。"
      ],
      "starter": "先写预测，再把 main.c 改为 scanf 读取分钟数后运行。",
      "source_refs": [
        "wg14-n1570"
      ],
      "availability": "practice_ready",
      "completion_limit": "只比较指定输入的状态和输出；硬编码可满足可见固定条件，不能据此证明一般正确性、解释或独立迁移。",
      "check_version": "code-fixed-condition-v1",
      "code_request": {
        "language": "c17",
        "entry": "main.c",
        "files": {
          "main.c": "#include <stdio.h>\nint main(void) {\nint minutes = 60, amount;\nif (minutes < 30) amount = 0;\nelse if (minutes < 60) amount = 5;\nelse amount = 10;\nprintf(\"%d\\n\", amount);\nreturn 0;\n}\n"
        },
        "stdin": ""
      },
      "reference_answer": {
        "language": "c17",
        "entry": "main.c",
        "files": {
          "main.c": "#include <stdio.h>\nint main(void) {\nint minutes, amount;\nscanf(\"%d\", &minutes);\nif (minutes <= 30) amount = 0;\nelse if (minutes <= 60) amount = 5;\nelse amount = 10;\nprintf(\"%d\\n\", amount);\nreturn 0;\n}\n"
        },
        "stdin": ""
      },
      "prediction_prompt": "逐步预测分支变量、输出与退出状态，并说明依据。",
      "reflection_prompt": "记录预测与真实结果的差异、把 < 改为 <= 的原因，以及为何固定输出仍不能证明整体正确。",
