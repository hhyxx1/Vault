  "activities": [
    {
      "id": "29756f45-a9b7-5aad-89b5-f3ce5c40ddb2",
      "version_id": "8aa993d0-d813-55e7-b40b-b2a246ad5224",
      "code": "CS01-M01-O01-CODE",
      "version": "CS01-M01-O01-CODE@0.1.0",
      "objective_codes": [
        "CS01-M01-O01"
      ],
      "kind": "code",
      "title": "让第一个程序运行起来",
      "student_action": "先判断程序会在哪个阶段失败。运行后定位错误，只改一处，再运行；保留预测与修改理由。修复后应输出 Hello, learner! 和换行。",
      "theory": [
        "GCC 构建可以经过预处理、编译、汇编、链接；构建失败时，不应把诊断当成程序输出。",
        "puts 输出字符串并补一个换行。本活动只验证声明环境中的有限程序，不要求记住诊断原文。"
      ],
      "starter": "编辑 main.c；先预测，再保存并运行。",
      "source_refs": [
        "gcc13-build",
        "gcc-c17",
        "wg14-n1570"
      ],
      "availability": "practice_ready",
      "completion_limit": "受限自学活动；实际运行只记录工具事实。解释、独立迁移和逐目标评估仍待可靠复核，不自动增加达标数。",
      "code_request": {
        "language": "c17",
        "entry": "main.c",
        "files": {
          "main.c": "#include <stdio.h>\nint main(void) {\n    puts(\"Hello, learner!\")\n    return 0;\n}\n"
        },
        "stdin": ""
